{
  "name": "c3-console",
  "version": "1.0.0",
  "description": "Personal console for calling C3 AI platform REST endpoints against any app",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.c3.tools.c3console",
    "productName": "c3-console",
    "files": [
      "main.js",
      "server.mjs",
      "public/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "publish": {
      "provider": "github",
      "owner": "c3-jack",
      "repo": "c3-console",
      "releaseType": "release"
    }
  }
}
